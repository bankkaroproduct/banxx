# Banxx (banxx.bankkaro.com) deployment configuration.
# Copy to .env.local for local development, or set these in the Vercel project.
# Never commit real values: .env* is gitignored.

# ---------------------------------------------------------------------------
# LAUNCH BLOCKING
# ---------------------------------------------------------------------------

# Banxx-specific partner API key, issued by BankKaro. Server-only, never
# NEXT_PUBLIC: this is what credits Credit Links for a conversion. Without a
# Banxx-specific key, clicks land in a shared pool and the partner is not
# credited. Unset means /api/token returns 500 and no card data loads.
PARTNER_API_KEY=

# Must be EXACTLY https://banxx.bankkaro.com with no trailing slash.
# It is the only dynamic entry in the /api/token origin allowlist. If it is
# unset or wrong, every token request 403s and the app renders blank.
# Verify with GET /api/health before announcing a deployment.
NEXT_PUBLIC_APP_URL=https://banxx.bankkaro.com

# ---------------------------------------------------------------------------
# PARTNER API ENDPOINTS
# ---------------------------------------------------------------------------

# Both default to production. Point them at UAT to test against a UAT-issued
# key: a prod base URL with a UAT key is the most likely cause of the
# historical 502 on cardgenius/cards.
# UAT: https://uat-platform.bankkaro.com/partner/token
PARTNER_TOKEN_URL=https://platform.bankkaro.com/partner/token
# UAT: https://uat-platform.bankkaro.com/partner
PARTNER_BASE_URL=https://platform.bankkaro.com/partner

# Journey Track ingestion endpoint.
JT_API_URL=

# ---------------------------------------------------------------------------
# BRANDING (optional overrides; Banxx defaults live in src/config/brand.config.ts)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_BRAND_NAME=Banxx
NEXT_PUBLIC_BRAND_TAGLINE=Find the credit card you actually qualify for
NEXT_PUBLIC_BRAND_EMAIL=support@banxx.com

# Wordmark assets. Leave EMPTY until the Credit Links design team supplies the
# clean SVG: BrandWordmark renders a text wordmark when these are unset. Setting
# them is the single swap point for the logo.
NEXT_PUBLIC_BRAND_LOGO=
NEXT_PUBLIC_BRAND_LOGO_DARK=
NEXT_PUBLIC_BRAND_FAVICON=/favicon.svg

# ---------------------------------------------------------------------------
# ANALYTICS
# ---------------------------------------------------------------------------

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ENABLE_REDIRECT_ANALYTICS=false
